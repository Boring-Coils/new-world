; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New World"
config/version="0.0.1.4"
run/main_scene="res://Scenes/Colony.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://ofm4rbgt6kj8"

[autoload]

WorldGridGlobal="*res://Scripts/Grid/WorldGridGlobal.gd"
TickManager="*res://Scripts/Core/TickManager.gd"
MaterialSystem="*res://Scripts/Core/MaterialSystem.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="New World"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_state_charts/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
